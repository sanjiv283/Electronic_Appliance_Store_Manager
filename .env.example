DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=XEPDB1
DB_USER=appliance_app
DB_PASSWORD=<set-locally>
FLASK_SECRET_KEY=<set-locally>
APP_ENV=development
HOST=127.0.0.1
PORT=8000
# Number of reverse proxies in front of the app (0 = none). Needed for the sign-in throttle to see real client addresses.
TRUSTED_PROXIES=0
